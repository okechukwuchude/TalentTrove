SESSION_SECRET=replace-with-a-random-string-at-least-32-characters-long
DATABASE_URL=postgres://user:password@localhost:5432/pinloop_web
APP_ORIGIN=http://localhost:3000
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=

# Postings ingestion — every variable below is independently optional. An
# adapter with none of its variables set simply fetches nothing; it is not
# an error. See "Configuring postings ingestion" in README.md for what each
# one does and where to get it.
JSEARCH_API_KEY=
JSEARCH_QUERIES=
JSEARCH_COUNTRY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=
ADZUNA_QUERIES=
GREENHOUSE_COMPANIES=
LEVER_COMPANIES=
ASHBY_COMPANIES=

# Required only for the /api/cron/ingest-postings route (Vercel Cron calls
# it with this as a bearer token). Any long random string; generate one the
# same way as SESSION_SECRET.
CRON_SECRET=

# Judging — screens newly-ingested postings against your stored profile via
# OpenRouter, on a schedule (see /api/cron/judge-postings). Both variables
# below are required for judging to run at all; unset, the job is a no-op.
OPENROUTER_API_KEY=
JUDGE_MODEL=
# Optional; defaults to 25 postings judged per scheduled run if unset.
JUDGE_BATCH_SIZE=

# Resume tailoring — generates a tailored resume PDF for each strong/fair
# judged posting via OpenRouter, on a schedule (see
# /api/cron/tailor-resumes). Reuses OPENROUTER_API_KEY and JUDGE_MODEL
# above; no separate key/model needed. Unset either and this job is a
# no-op, same as judging.
# Optional; defaults to 25 postings tailored per scheduled run if unset.
TAILOR_BATCH_SIZE=
